{
  "name": "drone-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "restart": "bun run build && bun run drone hub stop && bun run drone hub start",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:auto-continue-eval": "bun run --filter drone test:auto-continue-eval",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "smoke": "node scripts/smoke/smoke-all.cjs && node scripts/smoke/smoke-docker-all.cjs",
    "smoke:docker": "node scripts/smoke/smoke-docker-all.cjs",
    "dvm": "bun run --filter dvm dev --",
    "drone": "bun run --filter drone dev --",
    "drone-hub": "bun run --filter drone-hub dev",
    "voice-stream": "bun run --filter voice-stream dev",
    "voice-stream-next": "bun run --filter voice-stream-next dev",
    "voice-stream-next:apk": "bun run --filter voice-stream-next apk",
    "voice-stream-next:android": "bun run --filter voice-stream-next android:assembleDebug",
    "voice-stream-next:desktop": "bun run --filter voice-stream-next desktop",
    "voice-stream-next:server": "bun run --filter voice-stream-next dev:server",
    "voice-stream-next:web": "bun run --filter voice-stream-next dev:web",
    "voice-stream:apk": "bun run --filter voice-stream apk",
    "looped": "bun run --cwd apps/looped dev --",
    "regression": "bun run build && bun run smoke && bun run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "bun@1.2.23"
}
