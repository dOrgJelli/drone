{
  "name": "voice-stream-next",
  "version": "0.1.0",
  "description": "VoiceStream desktop, web, Android, and assistant service.",
  "author": "Huntelkator",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5185",
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "VOICE_STREAM_NEXT_WEB_URL=http://127.0.0.1:5185 electron desktop/main.cjs",
    "desktop:pack": "bun scripts/pack-desktop.mjs",
    "desktop:dist": "bun run desktop:pack",
    "apk": "./gradlew :android:app:assembleDebug",
    "android:assembleDebug": "./gradlew :android:app:assembleDebug",
    "android:assembleRelease": "./gradlew :android:app:assembleRelease",
    "android:bundleRelease": "./gradlew :android:app:bundleRelease",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun server/src/index.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/fastify": "^3.1.30",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fastify": "^5.8.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.7"
  },
  "optionalDependencies": {
    "vosk": "^0.3.39"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@electron/packager": "^18.4.4",
    "electron": "31.7.7",
    "typescript": "^5.6.3"
  }
}
