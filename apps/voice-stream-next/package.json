{
  "name": "voice-stream-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.mjs",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5185",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun server/src/index.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/fastify": "^3.1.30",
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "fastify": "^5.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.3"
  }
}
